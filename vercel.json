{
  "version": 2,
  "builds": [
    { 
      "src": "book-admin/api/index.py", 
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.11",
        "includeFiles": "book-admin/api/requirements.txt",
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/book-admin/api/index.py" }
  ]
}
