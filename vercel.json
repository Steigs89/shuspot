{
	"headers": [
		{
			"source": "/",
			"headers": [
				{ "key": "Cache-Control", "value": "no-store" }
			]
		},
		{
			"source": "/book-admin/index.html",
			"headers": [
				{ "key": "Cache-Control", "value": "no-store" }
			]
		}
	],
	"routes": [
	{ "src": "^/api/(.*)$", "dest": "/api/$1" },
	{ "src": "^/static/(.*)$", "dest": "/book-admin/static/$1" },
	{ "src": "^/asset-manifest\\.json$", "dest": "/book-admin/asset-manifest.json" },
	{ "src": "^/favicon\\.svg$", "dest": "/book-admin/favicon.svg" },
	{ "src": "^/index\\.html$", "dest": "/book-admin/index.html" },
	{ "src": "^/$", "dest": "/book-admin/index.html" },
	{ "src": "^(?!/(api|static|asset-manifest\\.json|favicon\\.svg|book-admin)/).*$", "dest": "/book-admin/index.html" }
	]
}
