{
  "version": 2,
  "builds": [
    { "src": "book-admin/frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } },
    { "src": "book-admin/api/**/*.py", "use": "@vercel/python" }
  ],
  "routes": [
  { "src": "/static/(.*)", "dest": "/frontend/static/$1" },
  { "src": "/favicon\\.svg", "dest": "/frontend/favicon.svg" },
  { "src": "/asset-manifest\\.json", "dest": "/frontend/asset-manifest.json" },
  { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
  { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
  { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
