{
  "version": 2,
  "builds": [
    { 
      "src": "book-admin/api/index.py", 
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.11",
        "includeFiles": ["book-admin/api/**/*.py", "book-admin/api/requirements.txt"],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/book-admin/api/index.py" },
    { "src": "/health", "dest": "/book-admin/api/index.py" },
    { "src": "/ping", "dest": "/book-admin/api/index.py" },
    { "src": "/(.*)", "dest": "/book-admin/api/index.py" }
  ]
}
