{
	"version": 2,
	"headers": [
		{ "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] },
		{ "source": "/book-admin/index.html", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
	],
		"routes": [
			{ "handle": "headers" },
			{ "source": "/", "headers": { "Cache-Control": "no-store" } },
			{ "source": "/book-admin/index.html", "headers": { "Cache-Control": "no-store" } },

			{ "handle": "filesystem" },

			{ "src": "/static/(.*)", "dest": "/book-admin/static/$1" },
			{ "src": "/asset-manifest.json", "dest": "/book-admin/asset-manifest.json" },
			{ "src": "/favicon.svg", "dest": "/book-admin/favicon.svg" },
			{ "src": "/index.html", "dest": "/book-admin/index.html" },
			{ "src": "/", "dest": "/book-admin/index.html" },
			{ "src": "/(?!api/).*", "dest": "/book-admin/index.html" }
		]
}
