{
  "version": 2,
  "builds": [
    { "src": "api/simplified_index.py", "use": "@vercel/python" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "../build" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/simplified_index.py" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
