{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    { 
      "src": "api/**/*.py", 
      "use": "@vercel/python" 
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/static/(.*)", "dest": "/frontend/build/static/$1" },
    { "src": "/favicon\\.svg", "dest": "/frontend/build/favicon.svg" },
    { "src": "/asset-manifest\\.json", "dest": "/frontend/build/asset-manifest.json" },
    { "src": "/js/(.*)", "dest": "/frontend/build/js/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/build/index.html" }
  ]
}
