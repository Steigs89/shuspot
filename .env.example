# Supabase Configuration
REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Backend API Configuration
REACT_APP_API_URL=http://localhost:3001/api

# Alibaba Cloud OSS Configuration (for file storage)
REACT_APP_OSS_REGION=oss-cn-hangzhou
REACT_APP_OSS_BUCKET=your-bucket-name
REACT_APP_OSS_ACCESS_KEY_ID=your_access_key_id
REACT_APP_OSS_ACCESS_KEY_SECRET=your_access_key_secret

# iFlyTek ISE (Pronunciation Assessment) Configuration
# Get credentials at: global.xfyun.cn/products/ise
VITE_IFLYTEK_APP_ID=your_iflytek_app_id
VITE_IFLYTEK_API_KEY=your_iflytek_api_key
VITE_IFLYTEK_API_SECRET=your_iflytek_api_secret

# LibreTranslate — for EN/ZH toggle in VoiceCoachPracticeInterface
# Run locally: docker run -p 5000:5000 libretranslate/libretranslate
# Or use a hosted instance: https://libretranslate.com
VITE_LIBRETRANSLATE_URL=http://localhost:5000

# App Configuration
REACT_APP_APP_NAME=Read to Me
REACT_APP_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Analytics (optional)
REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Social Login (optional)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id
REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id